DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local Docker Compose PostgreSQL credentials; use Secret Manager in GCP.
DB_NAME=staffing
DB_USER=staffing
DB_PASSWORD=staffing-local

VITE_API_BASE_URL=http://localhost:8000

# Carpeta con Staff.csv y Assignments.csv que importa compose al arrancar.
# Por defecto datos inventados (backend/sample-data/). Datos reales: CSV_DIR=.
# CSV_DIR=./backend/sample-data

# Solo para compose.prod.yaml (prueba de las imagenes de produccion).
# Genera una clave: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=
CORS_ALLOWED_ORIGINS_PROD=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8000
VITE_API_BASE_URL_PROD=http://localhost:8000
